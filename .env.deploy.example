# Copy to .env.deploy.local (ignored). Never place token values in this file.
CF_ACCOUNT_ID=your-personal-account-id
CF_ZONE_NAME=example.com
CF_OWNER_EMAIL=owner@example.com
DASHBOARD_HOSTNAME=remote-console.example.com
RDP_HOSTNAME=rdp.example.com
PC_NAME=home-pc
PC_IP=192.168.1.100
PC_MAC=AA:BB:CC:DD:EE:FF
WOL_BROADCAST=192.168.1.255
SSH_HOST=remote-console
TUNNEL_NAME=remote-console
# Defaults to ~/.config/remote-console/cloudflare-api-token
# CLOUDFLARE_API_TOKEN_FILE=/absolute/private/path
