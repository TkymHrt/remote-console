{
  "name": "remote-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:server": "node --watch --env-file=.env server/index.ts",
    "build": "tsc -b && NODE_ENV=production vp build && vp pack",
    "check": "vp check",
    "typecheck": "tsc -b",
    "test": "vp test",
    "start": "node --env-file-if-exists=.env dist/server/index.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.2",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.10",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
