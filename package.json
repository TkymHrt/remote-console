{
  "name": "remote-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors cyan,green \"vp dev\" \"node --watch --env-file-if-exists=.env --import tsx src/server/index.ts\"",
    "build": "vp build && vp pack",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "check": "vp check",
    "test": "vp test",
    "test:watch": "vp test watch"
  },
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.12.31",
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource/line-seed-jp": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@11.17.0"
}
