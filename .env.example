# Runtime
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Target values exist only on the server. Never expose these through VITE_* variables.
TARGET_NAME=自宅PC
TARGET_IP=192.168.11.3
TARGET_MAC=9C:6B:00:94:06:8A
RDP_PORT=3389
RDP_URL=https://rdp.tkymhrt.dpdns.org/rdp/1d2a8e0b-3bf8-4c62-bba1-5a797e224c58/192.168.11.3/3389

# Wake-on-LAN broadcast
WOL_BROADCAST_ADDRESS=192.168.11.255
WOL_BIND_ADDRESS=0.0.0.0
WOL_PORT=9
WOL_PACKET_COUNT=3
WOL_PACKET_INTERVAL_MS=100

# Probe and lifecycle timing
RDP_CONNECT_TIMEOUT_MS=1500
RDP_PROBE_CACHE_MS=1000
STARTUP_TIMEOUT_SECONDS=180
WAKE_COOLDOWN_SECONDS=60

# Per-identity in-memory request limits
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SECONDS=60
WAKE_RATE_LIMIT_MAX=5
WAKE_RATE_LIMIT_WINDOW_SECONDS=900

# Cloudflare Access JWT validation. Production defaults to "required".
# Development defaults to "disabled"; production defaults to "required".
# Keep these commented for local use. Uncomment and replace both in production.
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUD=replace-with-access-application-aud-tag
