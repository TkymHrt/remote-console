# Production is the default. Access configuration is mandatory.
NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://console.example.com

PC_NAME=自宅PC
PC_IP=192.168.1.100
PC_MAC=AA:BB:CC:DD:EE:FF
WOL_BROADCAST=192.168.1.255
WOL_PORT=9
BOOT_TIMEOUT_MS=120000

# Copy the actual URL opened by the Cloudflare Access RDP target tile.
# The app never stores or handles Windows credentials.
BROWSER_RDP_URL=https://rdp.example.com/rdp/your-virtual-network-id/192.168.1.100/3389
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-dashboard-application-audience-tag
