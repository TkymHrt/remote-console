[Unit]
Description=Remote Console Wake-on-LAN service
Documentation=https://github.com/TkymHrt/remote-console
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=remote-console
Group=remote-console
WorkingDirectory=/opt/remote-console
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/remote-console/.env
ExecStart=/usr/bin/env node dist/server.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
